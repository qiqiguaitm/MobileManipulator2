# SetPosition.srv - /piper/set_position
# Position control service

# Request
float32 x                      # mm (NaN = keep current)
float32 y                      # mm
float32 z                      # mm
float32 roll                   # degrees
float32 pitch                  # degrees
float32 yaw                    # degrees
int32 speed                    # 1-100% (default 30)
bool use_gripper_center        # true=gripper center coords (default true)
bool wait                      # wait for completion (default true)
---
# Response
bool success
string message
float32[] actual_position      # [x,y,z,r,p,y] mm/degrees
