# GraspDetect.srv - Grasp detection service interface
# Compatible with perception node

# === Request ===
string prompt                    # Detection prompt (e.g. "bottle.cup" or "box")
bool enable_cdm                  # Enable CDM depth optimization (default true)

---

# === Response ===
bool success                     # Detection succeeded
string error_message             # Error message (on failure)

# Core 3D output (camera optical frame: Z forward, X right, Y down)
float64[] point3d                # [x, y, z] meters (length=3)
float64 width3d                  # Gripper width meters
float64 angle                    # Grasp angle degrees (not radians)
string category                  # Object category
float64 score                    # Grasp confidence

# 2D info (auxiliary)
float64[] center_uv              # [u, v] pixel coordinates (length=2)
float64 depth                    # Center point depth meters

# Statistics
float64 detection_time_ms        # Detection time ms
