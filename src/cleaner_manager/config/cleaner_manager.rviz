Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 362
  - Class: cleaner_manager/CleanerPanel
    Name: Cleaner Control
    grasp_dist_max: 6.00
    grasp_size_max: 0.25
    grasp_size_min: 0.02
    grasp_z_max: 0.50
    grasp_z_min: -0.30
  - Class: cleaner_manager/PerceptionPanel
    Name: Perception
  - Class: piper_grasp/PiperGraspPanel
    Name: Piper Grasp
    prompt: can.vegetable.bottle.box.food.Rubik's cube.tool
