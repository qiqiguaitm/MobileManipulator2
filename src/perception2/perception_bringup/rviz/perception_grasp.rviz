Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    # 网格
    - Alpha: 0.5
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true

    # TF 坐标系 (只显示关键 frames)
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        arm_base:
          Value: true
        base_link:
          Value: true
        box_link:
          Value: false
        calibration/chassis_camera_optical:
          Value: false
        calibration/chassis_camera_physical:
          Value: false
        calibration/lidar:
          Value: false
        calibration/top_camera_optical:
          Value: false
        calibration/top_camera_physical:
          Value: false
        camera/chassis_link:
          Value: false
        camera/hand_aligned_depth_to_color_frame:
          Value: false
        camera/hand_color_frame:
          Value: false
        camera/hand_color_optical_frame:
          Value: false
        camera/hand_depth_frame:
          Value: false
        camera/hand_depth_optical_frame:
          Value: false
        camera/hand_link:
          Value: false
        camera/top_link:
          Value: false
        chassis_camera_link:
          Value: true
        gripper_link:
          Value: true
        hand_camera_link:
          Value: true
        lidar_link:
          Value: true
        lifting_link:
          Value: false
        link1:
          Value: false
        link2:
          Value: false
        link3:
          Value: false
        link4:
          Value: false
        link5:
          Value: false
        link6:
          Value: false
        link7:
          Value: false
        link8:
          Value: false
        top_camera_link:
          Value: true
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true

    # 机器人模型
    - Alpha: 0.8
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        arm_base:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        box_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        chassis_camera_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        camera/hand_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        lidar_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        lifting_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link2:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link3:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link4:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link5:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link6:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link7:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        link8:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        gripper_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        top_camera_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true

    # RGBD 点云 (CDM 优化后)
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: PointCloud
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.003
      Style: Points
      Topic: /perception_grasp_rviz_node/vis/pointcloud
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # 抓取 Markers (point, arrow, gripper, bbox_3d, label)
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic: /perception_grasp_rviz_node/markers
      Name: GraspMarkers
      Namespaces:
        grasp: true
      Queue Size: 100
      Value: true

    # 抓取位姿
    - Alpha: 1
      Axes Length: 0.1
      Axes Radius: 0.01
      Class: rviz_default_plugins/Pose
      Color: 255; 25; 0
      Enabled: true
      Head Length: 0.03
      Head Radius: 0.02
      Name: GraspPose
      Shaft Length: 0.1
      Shaft Radius: 0.01
      Shape: Axes
      Topic: /perception_grasp_rviz_node/grasp_pose
      Unreliable: false
      Value: true

    # 2x2 可视化面板 (Detection, Mask, Grasp, Depth)
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Panel
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception_grasp_rviz_node/vis/panel
      Value: true

    # 原始相机图像 (可选)
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: RawImage
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/hand/color/image_raw
      Value: false

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Panel:
    collapsed: false
  QMainWindow State: 
  Views:
    collapsed: true
  Width: 1400
  X: 100
  Y: 100
