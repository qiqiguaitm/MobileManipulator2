<?xml version="1.0"?>
<launch>
  <!-- ========== 参数 ========== -->
  <!-- 性能模式: 0=禁用, 1=节能模式(1Hz), 3=高性能模式(3Hz) -->
  <arg name="perf_mode" default="1" doc="性能模式: 0=禁用实时可视化, 1=节能模式(默认), 3=高性能模式"/>
  
  <arg name="camera_name" default="top"/>
  <arg name="target_frame" default="base_link"/>
  <arg name="publish_rgb_cloud" default="true"/>
  <arg name="publish_rate" default="1.0"/>  <!-- 优化: 平衡性能和可用性 -->
  <arg name="depth_max" default="5.0"/>
  <arg name="cloud_skip" default="1"/>  <!-- 点云降采样 (1=不降采样，配合image_scale使用) -->
  <arg name="image_scale" default="0.5"/>  <!-- 图像缩放 (0.5=1/4点数，效果比降采样更平滑) -->
  <arg name="depth_alpha" default="0.7"/>  <!-- EMA 时间平滑系数 (0.7=快响应, 0.3=强平滑) -->

  <!-- 噪点过滤参数 -->
  <arg name="enable_outlier_filter" default="false"/>  <!-- 禁用离群点过滤减少CPU -->
  <arg name="outlier_radius" default="0.05"/>  <!-- 邻域半径 (m) -->
  <arg name="outlier_min_neighbors" default="5"/>  <!-- 最小邻居数 -->

  <!-- LiDAR 距离着色参数 -->
  <arg name="lidar_topic" default="/rslidar_points"/>  <!-- LiDAR 订阅 topic -->
  <arg name="lidar_min_range" default="0.0"/>  <!-- 最小距离 (m) - 蓝色 -->
  <arg name="lidar_max_range" default="10.0"/>  <!-- 最大距离 (m) - 红色 -->
  <arg name="lidar_skip" default="1"/>  <!-- 降采样 (1=不降采样, 2=每2个取1个) -->
  <arg name="lidar_publish_rate" default="10.0"/>  <!-- LiDAR 发布频率 (Hz) -->

  <arg name="rviz" default="true"/>
  <arg name="use_fake_joints" default="true" doc="启动假关节发布器 (AMR集成时设为false)"/>

  <!-- ========== 机器人模型 ========== -->
  <include file="$(find mobile_manipulator2_description)/launch/load_description.launch">
    <arg name="collision_mode" value="performance"/>
  </include>

  <!-- Joint State Publisher (用于显示机器人模型，AMR集成时禁用) -->
  <node if="$(arg use_fake_joints)" name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
    <param name="use_gui" value="false"/>
  </node>

  <!-- ========== LiDAR TF (lidar_link -> rslidar) ========== -->
  <!-- LiDAR 驱动发布 frame_id=rslidar, URDF 中是 lidar_link -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="lidar_link_to_rslidar"
        args="0 0 0 0 0 0 lidar_link rslidar"/>

  <!-- ========== RViz 可视化节点 (始终启动，支持 service 结果可视化) ========== -->
  <!-- perf_mode=0 时禁用实时可视化，但保留节点以显示 service 调用结果 -->
  <node name="perception_rviz_node" pkg="perception" type="perception_rviz_node.py" output="screen"
        respawn="true" respawn_delay="3">
    <param name="camera_name" value="$(arg camera_name)"/>
    <param name="target_frame" value="$(arg target_frame)"/>
    <param name="publish_rgb_cloud" value="$(arg publish_rgb_cloud)"/>
    <!-- 性能模式自适应参数 (perf_mode=0 时使用最低参数) -->
    <param name="publish_rate" value="$(eval 0.0 if arg('perf_mode')==0 else (1.0 if arg('perf_mode')==1 else 2.5))"/>
    <param name="image_scale" value="$(eval 0.1 if arg('perf_mode')==0 else (0.25 if arg('perf_mode')==1 else 0.4))"/>
    <param name="cloud_skip" value="$(eval 10 if arg('perf_mode')==0 else (3 if arg('perf_mode')==1 else 1))"/>
    <param name="lidar_skip" value="$(eval 10 if arg('perf_mode')==0 else (4 if arg('perf_mode')==1 else 2))"/>
    <param name="lidar_publish_rate" value="$(eval 0.0 if arg('perf_mode')==0 else (3.0 if arg('perf_mode')==1 else 8.0))"/>
    <!-- 固定参数 -->
    <param name="depth_max" value="$(arg depth_max)"/>
    <param name="depth_alpha" value="$(arg depth_alpha)"/>
    <param name="enable_outlier_filter" value="$(arg enable_outlier_filter)"/>
    <param name="outlier_radius" value="$(arg outlier_radius)"/>
    <param name="outlier_min_neighbors" value="$(arg outlier_min_neighbors)"/>
    <param name="lidar_topic" value="$(arg lidar_topic)"/>
    <param name="lidar_min_range" value="$(arg lidar_min_range)"/>
    <param name="lidar_max_range" value="$(arg lidar_max_range)"/>
  </node>

  <!-- ========== RViz ========== -->
  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find perception)/config/perception_3d.rviz"
        launch-prefix="$(find integration)/scripts/rviz_wrapper.sh"/>
</launch>
