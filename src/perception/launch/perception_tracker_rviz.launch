<launch>
  <!-- 完整感知+跟踪+RViz可视化 -->
  <!-- 使用统一的 perception_3d.rviz，Tracker 可视化需手动启用 -->

  <!-- 参数 -->
  <arg name="camera_name" default="top"/>
  <arg name="enable_lidar" default="false"/>
  <arg name="enable_tracker" default="true"/>
  <arg name="tracker_url" default="http://192.168.112.14:11086"/>
  <arg name="track_rate" default="5.0"/>
  <arg name="target_frame" default="base_link"/>

  <!-- 启动感知+跟踪+可视化 -->
  <include file="$(find perception)/launch/scene_perception_3d.launch">
    <arg name="camera_name" value="$(arg camera_name)"/>
    <arg name="enable_lidar" value="$(arg enable_lidar)"/>
    <arg name="target_frame" value="$(arg target_frame)"/>
    <arg name="enable_tracker" value="$(arg enable_tracker)"/>
    <arg name="tracker_url" value="$(arg tracker_url)"/>
    <arg name="track_rate" value="$(arg track_rate)"/>
    <arg name="enable_rviz_viz" value="true"/>
  </include>

  <!-- 启动 RViz (统一配置，Tracker 项需手动启用) -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find perception)/config/perception_3d.rviz"
        launch-prefix="$(find integration)/scripts/rviz_wrapper.sh"
        output="screen"/>

</launch>
