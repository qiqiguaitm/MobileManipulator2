<?xml version="1.0"?>
<launch>
  <!-- Perception Grasp 节点 - 基于手部相机的抓取感知 -->

  <!-- 参数 -->
  <arg name="realtime_mode" default="true" doc="是否启用实时检测模式 (默认启用，同时支持 service 模式)"/>
  <arg name="rate" default="1.0" doc="实时模式帧率 Hz (调整为1Hz以降低计算负载)"/>

  <!-- 感知节点 -->
  <node name="perception_grasp_node" pkg="perception" type="perception_grasp_node.py" output="screen"
        respawn="true" respawn_delay="3">
    <!-- 加载配置文件 -->
    <rosparam file="$(find perception)/config/perception_grasp.yaml" command="load"/>

    <!-- 覆盖参数 -->
    <param name="perception_grasp/trigger/realtime_mode/enabled" value="$(arg realtime_mode)"/>
    <param name="perception_grasp/trigger/realtime_mode/rate" value="$(arg rate)"/>
  </node>

</launch>
