Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /TF1/Frames1
        - /Top Camera1
        - /Top Camera1/Top RGB-D PointCloud1
        - /Top Camera1/Top Object Markers1
        - /Chassis Camera1
        - /Chassis Camera1/Chassis RGB-D PointCloud1
        - /Chassis Camera1/Chassis Object Markers1
        - /Fused Results1
        - /Fused Results1/Fused Object Markers1
        - /LiDAR1
        - /2D Images1
      Splitter Ratio: 0.5
    Tree Height: 278
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: base_link
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        arm_base:
          Value: true
        base_link:
          Value: true
        body:
          Value: true
        box_link:
          Value: true
        calibration/chassis_camera_optical:
          Value: true
        calibration/chassis_camera_physical:
          Value: true
        calibration/lidar:
          Value: true
        calibration/top_camera_optical:
          Value: true
        calibration/top_camera_physical:
          Value: true
        camera/chassis_link:
          Value: true
        camera/hand_link:
          Value: true
        camera/top_link:
          Value: true
        camera_init:
          Value: true
        chassis_camera_link:
          Value: true
        chassis_color_frame:
          Value: true
        chassis_color_optical_frame:
          Value: true
        chassis_depth_frame:
          Value: true
        chassis_depth_optical_frame:
          Value: true
        chassis_link:
          Value: true
        hand_camera_link:
          Value: true
        lidar_link:
          Value: true
        lifting_link:
          Value: true
        link1:
          Value: true
        link2:
          Value: true
        link3:
          Value: true
        link4:
          Value: true
        link5:
          Value: true
        link6:
          Value: true
        link7:
          Value: true
        link8:
          Value: true
        map:
          Value: true
        odom:
          Value: true
        rslidar:
          Value: true
        top_camera_link:
          Value: true
        top_color_frame:
          Value: true
        top_color_optical_frame:
          Value: true
        top_depth_frame:
          Value: true
        top_depth_optical_frame:
          Value: true
        top_link:
          Value: true
      Marker Scale: 0.30000001192092896
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          odom:
            camera_init:
              body:
                base_link:
                  box_link:
                    arm_base:
                      link1:
                        link2:
                          link3:
                            link4:
                              link5:
                                link6:
                                  hand_camera_link:
                                    camera/hand_link:
                                      {}
                                  link7:
                                    {}
                                  link8:
                                    {}
                    lifting_link:
                      top_camera_link:
                        camera/top_link:
                          {}
                  calibration/lidar:
                    calibration/chassis_camera_physical:
                      calibration/chassis_camera_optical:
                        {}
                    calibration/top_camera_physical:
                      calibration/top_camera_optical:
                        {}
                  lidar_link:
                    chassis_camera_link:
                      camera/chassis_link:
                        {}
                    rslidar:
                      {}
      Update Interval: 0
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: RGB8
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: Top RGB-D PointCloud
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.009999999776482582
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /multi_camera_rviz/top/rgb_pointcloud
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Top Object Markers
          Namespaces:
            top_distance_labels: true
            top_object_bbox: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /multi_camera_rviz/top/object_markers
          Value: true
      Enabled: true
      Name: Top Camera
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: RGB8
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: Chassis RGB-D PointCloud
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.009999999776482582
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /multi_camera_rviz/chassis/rgb_pointcloud
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Chassis Object Markers
          Namespaces:
            chassis_distance_labels: true
            chassis_object_bbox: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /multi_camera_rviz/chassis/object_markers
          Value: true
      Enabled: true
      Name: Chassis Camera
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Fused Object Markers
          Namespaces:
            fused_distance_labels: true
            fused_object_bbox: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /multi_camera_rviz/fused/object_markers
          Value: true
      Enabled: true
      Name: Fused Results
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: RGB8
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: LiDAR PointCloud
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.029999999329447746
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /multi_camera_rviz/lidar_colored
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
      Enabled: false
      Name: LiDAR
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/Image
          Enabled: true
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: Top Detection Image
          Normalize Range: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /multi_camera_rviz/top/detection_image
          Value: true
        - Class: rviz_default_plugins/Image
          Enabled: true
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: Chassis Detection Image
          Normalize Range: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /multi_camera_rviz/chassis/detection_image
          Value: true
      Enabled: true
      Name: 2D Images
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.5
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 0.800000011920929
    Saved: ~
