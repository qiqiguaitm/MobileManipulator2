/**:
    ros__parameters:
        feature_extract_enable: false
        point_filter_num: 2
        max_iteration: 4
        filter_size_surf: 0.5
        filter_size_map: 0.5
        cube_side_length: 200.0
        runtime_pos_log_enable: false

        common:
            lid_topic: "/rslidar_points"
            imu_topic: "/imu/data"
            time_sync_en: false
            time_offset_lidar_to_imu: 0.0

        preprocess:
            lidar_type: 2                # 2 for Velodyne/Robosense
            scan_line: 16                # Helios 16P = 16线
            blind: 0.8                   # 盲区0.8m
            timestamp_unit: 0            # 秒
            scan_rate: 10                # 10Hz

        mapping:
            acc_cov: 0.05
            gyr_cov: 0.05
            b_acc_cov: 0.00005
            b_gyr_cov: 0.00005
            fov_degree: 360.0
            det_range: 100.0
            extrinsic_est_en: false
            extrinsic_T: [ 0.27254, 0.00035, 0.095 ]
            extrinsic_R: [ 1., 0., 0.,
                           0., 1., 0.,
                           0., 0., 1. ]

        publish:
            path_en: true
            scan_publish_en: true
            dense_publish_en: false
            scan_bodyframe_pub_en: true

        pcd_save:
            pcd_save_en: false
            interval: -1
