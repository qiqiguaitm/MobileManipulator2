Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 1.0
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Draw Behind: true
    Enabled: true
    Name: Recorded Map
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /reference/map
    Use Timestamp: false
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 255; 0; 0
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Recorded Laser
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.029999999329447746
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /reference/scan
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/Path
    Name: Playback Trajectory
    Enabled: true
    Value: true
    Topic:
      Value: /replay/path
      Depth: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Color: 230; 110; 40
    Line Style: Lines
    Line Width: 0.04
    Buffer Length: 1
  - Class: rviz_default_plugins/Pose
    Name: Recorded Robot Pose
    Enabled: true
    Value: true
    Topic:
      Value: /reference/trajectory
      Depth: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Shape: Arrow
    Color: 255; 170; 0
  - Class: rviz_default_plugins/Image
    Name: Recorded RGB
    Enabled: true
    Value: true
    Topic:
      Value: /reference/camera/top/color/image_raw
      Depth: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Transport Hint: raw
    Normalize Range: true
  - Class: rviz_default_plugins/Path
    Name: Teleoperation Reference
    Enabled: true
    Value: true
    Topic:
      Value: /replay/reference_path
      Depth: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Color: 40; 135; 200
    Line Style: Lines
    Line Width: 0.025
    Buffer Length: 1
  - Class: rviz_default_plugins/Path
    Name: Global Plan
    Enabled: true
    Value: true
    Topic:
      Value: /replay/planned_path
      Depth: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color: 40; 190; 70
    Line Style: Lines
    Line Width: 0.025
    Buffer Length: 1
  - Class: rviz_default_plugins/Pose
    Name: Stopping Goal
    Enabled: true
    Value: true
    Topic:
      Value: /replay/display_goal
      Depth: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Shape: Arrow
    Color: 230; 110; 40
  - Class: rviz_default_plugins/Marker
    Name: Robot Footprint Box
    Enabled: true
    Value: true
    Namespaces: {}
    Queue Size: 100
    Topic:
      Value: /replay/robot_box
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0.0
      Scale: 100.0
      X: -1.8
      Y: 0.8
      Target Frame: <Fixed Frame>
      Near Clip Distance: 0.01
      Invert Z Axis: false
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: null
Window Geometry:
  Width: 1400
  Height: 900
  X: 80
  Y: 60
